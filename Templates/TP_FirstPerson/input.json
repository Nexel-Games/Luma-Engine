    },
    "moveBackward": {
      "key": "S",
      "type": "key",
      "action": "hold"
    },
    "moveLeft": {
      "key": "A",
      "type": "key",
      "action": "hold"
    },
    "moveRight": {
      "key": "D",
      "type": "key",
      "action": "hold"
    },
    "jump": {
